# Subdomain-based routing, not path-based (unlike zap/Beacon Essentials) — this app's
# frontend and backend talk cross-origin (browser calls NEXT_PUBLIC_API_BROWSER
# directly), so there's no single origin to path-trim /api/* off of. Two site blocks,
# each terminating its own TLS cert via DNS-01 (see caddy/Dockerfile for why).
#
# Currently pointed at throwaway test subdomains, deliberately: the migration plan
# requires proving real TLS issuance + routing before production DNS is touched at all.
# At cutover, swap these two host lines to laudtetteh.io + www.laudtetteh.io (web) and
# api.laudtetteh.io (api). Full plan and rationale live in this project's internal
# planning notes (external Rig dir), not in-repo — see issue #76.

ovh-test.laudtetteh.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	reverse_proxy web:3000
}

api-ovh-test.laudtetteh.io {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	reverse_proxy api:8000
}
